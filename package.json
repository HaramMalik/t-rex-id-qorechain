{
  "name": "t-rex-id-qorechain",
  "version": "1.0.0",
  "license": "MIT",
  "private": false,
  "description": "T-REX ID: Quantum-Safe ERC-3643 Institutional RWA Identity, Compliance & Sovereign Bond Integration on QoreChain Diana Testnet (Chain ID: 9800)",
  "type": "module",
  "scripts": {
    "verify:live": "node scripts/verifyLiveState.mjs",
    "verify:compliance": "node scripts/testComplianceIntegration.mjs",
    "compile:contracts": "hardhat compile",
    "test": "hardhat test",
    "deploy:pqc-module": "hardhat compile && node scripts/deployTrexPqcModule.mjs",
    "deploy:qorechain-all": "hardhat compile && node scripts/deployQorechainExtensions.mjs",
    "deploy:qorechain-all:sync": "hardhat compile && node scripts/deployQorechainExtensions.mjs --dispatch-sync",
    "scan:cbom": "qorescan scan --network testnet --address qor18sp9j6zplpun44zu4ryqdzpq6cs2wc7mrtt9ad --address qor19y6ah0umdhueq85g9m30xvzrxxeujzcrcqeymm --address qor1xkgjactk7qpcqr4arfsgrx5a75g50ne6uwv0qr --tls evm-testnet.qore.host:443 --solidity ./contracts --name t-rex-id-qorechain --out cbom.json && qorescan report --framework finma --cbom cbom.json --out FINMA_PQC_REPORT.md",
    "start:proxy": "tsx server/qorechainProxy.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@qorechain/asset-kit": "^0.1.0",
    "@qorechain/pqc": "^0.2.3",
    "@qorechain/qorescan": "^0.1.0",
    "@qorechain/qoreseal": "^0.1.0",
    "@qorechain/qoresign": "^0.1.1",
    "@qorechain/sdk": "^0.12.0",
    "@qorechain/wallet-adapter": "^0.4.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "chai": "^4.5.0",
    "hardhat": "^3.9.1",
    "mocha": "^12.0.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
